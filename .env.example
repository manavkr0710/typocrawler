# Copy to .env and fill in — .env is gitignored, never commit real tokens.

# Fine-grained PAT, "Public Repositories (read-only)" access, no extra permissions needed.
GITHUB_TOKEN=

# For `typocrawler verify` — set ONE of these (or use --provider ollama with neither).
# Groq is recommended: much larger free daily quota. https://console.groq.com/keys
GROQ_API_KEY=
# Gemini free tier caps daily requests very low for some models. https://aistudio.google.com/apikey
GEMINI_API_KEY=
